{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "mcp": {
    "pdf-reader": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uv",
        "run",
        "--directory",
        "/Users/fred/.config/opencode/mcp/pdf-reader",
        "python",
        "src/pdf_reader_mcp/__main__.py"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "ornith:35b-q8-code": {
          "name": "Coding · Ornith 35B Q8 — Fast"
        },
        "ornith:35b-q8-plan": {
          "name": "Planning · Ornith 35B Q8 — Probation"
        },
        "ornith:9b-q4-complete": {
          "name": "Utility · Ornith 9B — Small"
        },
        "llama3.3:70b-q8-prose": {
          "name": "Chat · Llama 3.3 70B Q8"
        },
        "gemma4:31b-bf16-python": {
          "name": "Python · Gemma 4 31B BF16 — Probation",
          "options": {
            "temperature": 0.2,
            "top_k": 40,
            "top_p": 0.9,
            "min_p": 0.02,
            "num_ctx": 131072,
            "num_predict": 16384,
            "repeat_penalty": 1.03
          }
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "timeout": 900000
      },
      "models": {
        "Laguna-S-2.1-NVFP4-mlx": {
          "name": "Coding · Laguna S 2.1 NVFP4",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "temperature": 0.2,
            "topP": 0.9,
            "topK": 40
          }
        },
        "Qwen3-Coder-Next-MLX-8bit": {
          "name": "Coding · Qwen3 Coder Next 8-bit",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        },
        "Qwen3-235B-A22B-3bit": {
          "name": "Architecture · Qwen3 235B A22B 3-bit",
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "temperature": 0.25,
            "top_p": 0.9
          }
        },
        "gpt-oss-120b-MLX-bf16": {
          "name": "OpenBrain · GPT-OSS 120B BF16",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "temperature": 0.2
          }
        },
        "Muse-Glimmer-30B-bf16": {
          "name": "Planning · Muse Glimmer 30B BF16 — Probation",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "temperature": 0.2,
            "top_p": 0.95
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Default development agent for implementation, debugging, testing, and normal repository work",
      "mode": "primary",
      "model": "omlx/Laguna-S-2.1-NVFP4-mlx",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "task": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "pdf-reader_*": "allow",
        "openbrain_*": "ask",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "deny",
          "rm *": "deny"
        }
      }
    },
    "plan": {
      "description": "Planning, decomposition, design exploration, and implementation strategy without modifying files",
      "mode": "primary",
      "model": "omlx/Muse-Glimmer-30B-bf16",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": "deny",
        "todowrite": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "pdf-reader_*": "allow",
        "openbrain_*": "ask"
      }
    },
    "openbrain": {
      "description": "Dedicated OpenBrain researcher and curator for durable project knowledge, retrieval, synthesis, and maintenance",
      "mode": "primary",
      "model": "omlx/gpt-oss-120b-MLX-bf16",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "openbrain_*": "allow",
        "pdf-reader_*": "allow",
        "okf_*": "allow",
        "context7_*": "allow",
        "github_*": "allow"
      }
    },
    "architect-235": {
      "description": "Deep architecture, difficult debugging, design review, tradeoff analysis, and code review",
      "mode": "primary",
      "model": "omlx/Qwen3-235B-A22B-3bit",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "pdf-reader_*": "allow",
        "openbrain_*": "deny"
      }
    },
    "coder-next": {
      "description": "Heavyweight coding agent for difficult implementation, repository-wide refactoring, debugging, and tests",
      "mode": "primary",
      "model": "omlx/Qwen3-Coder-Next-MLX-8bit",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "task": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "pdf-reader_*": "allow",
        "openbrain_*": "ask",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "deny",
          "rm *": "deny"
        }
      }
    },
    "fast-code": {
      "description": "Fast coding agent for smaller implementations, localized refactoring, debugging, and code questions",
      "mode": "primary",
      "model": "ollama/ornith:35b-q8-code",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "task": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "pdf-reader_*": "allow",
        "openbrain_*": "ask",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "deny",
          "rm *": "deny"
        }
      }
    },
    "prose": {
      "description": "General writing, explanation, documentation, and non-coding conversation",
      "mode": "primary",
      "model": "ollama/llama3.3:70b-q8-prose",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "openbrain_*": "ask",
        "context7_*": "allow"
      }
    },
    "python": {
      "description": "Python-focused coding and review; retained temporarily to evaluate Gemma against Laguna and Qwen Coder Next",
      "mode": "primary",
      "model": "ollama/gemma4:31b-bf16-python",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "task": "allow",
        "todowrite": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "context7_*": "allow",
        "github_*": "allow",
        "okf_*": "allow",
        "openbrain_*": "ask",
        "bash": {
          "*": "ask",
          "python *": "ask",
          "python3 *": "ask",
          "pytest *": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rm *": "deny",
          "git push*": "deny"
        }
      }
    }
  },
  "model": "omlx/Laguna-S-2.1-NVFP4-mlx",
  "small_model": "ollama/ornith:9b-q4-complete",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "git push*": "deny"
    }
  }
}
